[Unit]
Description=Snapshot the wg-easy database for the edge sync
# Nothing here orders this after the stack: wg-easy is started by `docker compose`,
# not by a unit, so a dependency would name something that does not exist. What
# protects the copy is the script, which refuses a missing or empty database and
# reports 0 instead of replacing the last good snapshot.

[Service]
Type=oneshot
ExecStart=@WG_LIB@/wg-snapshot.sh
