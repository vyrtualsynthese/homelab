# One file for both edge Pis. hosts-pi.sh writes it from this template, prints
# it with 'render' and compares it with 'verify', so the two Pi-holes cannot
# drift the way two hand-kept copies did: on 2026-11-25 they differed in four of
# 167 settings and nobody had noticed.
#
# Nothing here is a secret. The panel password is the only key in pihole.env,
# which stays on the host and is never rendered.
TZ=Europe/Paris

# Upstream resolvers, DNS4EU's unfiltered pair — an EU member-state resolver,
# per the providers decision, and unfiltered because Pi-hole is the only filter
# in the path (docs/decisions/2026-11-27-public-dns-is-dns4eu-unfiltered.md).
# The old PIHOLE_DNS_ key was a v5 leftover: a throwaway container on
# 2026-11-25 showed FTL ignores it, so the upstream actually in force was the one
# written in pihole.toml, and the file said something else.
FTLCONF_dns_upstreams=86.54.11.100;86.54.11.200

# How long a client caches a blocked answer, in seconds. Two, the default: a day
# means a site unblocked this morning still fails tonight. rbp0 carried 86400.
FTLCONF_dns_blockTTL=2

# Queries per client per minute. The default; the two hosts carried 1000 and
# 10000, and the LAN's peak is about 20.
FTLCONF_dns_rateLimit_count=1000

# Answer on every address the host holds, including the moving address the
# failover design puts in front of the pair, so that change needs nothing here.
FTLCONF_dns_listeningMode=ALL

# Reverse lookups for the LAN answered locally instead of forwarded upstream.
# rbp0 had this, rbp1 did not, and rbp1 was forwarding about 230 PTR queries a
# day to DNS4EU for its own neighbours.
FTLCONF_dns_revServers=true,192.168.1.0/24,192.168.1.1,local

# API sessions. The default is 16, they last 30 minutes, and nothing releases one
# early: an app password cannot delete a session, only the panel's own password
# can. hack/check_pihole_parity.py takes one per host per run, and the third run
# in half an hour hit `api_seats_exceeded`. 64 leaves room for the panel, the
# check and whatever else asks.
FTLCONF_webserver_api_max_sessions=64

# Pi-hole v6 stops loading /etc/dnsmasq.d unless it is told to: the key
# defaults to false, so the address= overrides in 02-my-wildcard-dns.conf were
# silently dead. They had survived because a copy also sat in the old
# FTLCONF_misc_dnsmasq_lines, which this file now owns and empties.
FTLCONF_misc_etc_dnsmasq_d=true

# The address=/... overrides live in etc-dnsmasq.d/02-my-wildcard-dns.conf,
# which is rendered and compared like this file, and mounted by the compose. The
# empty value below clears the copy the old environment carried, so there is one
# source, not two.
FTLCONF_misc_dnsmasq_lines=

# How long the query database keeps its detail.
FTLCONF_MAXNETAGE=30
FTLCONF_MAXDBDAYS=30

# The panel and API certificate: one combined PEM (certificate then key) per
# host, from the internal CA. Pi-hole reads both from `webserver.tls.cert`; the
# default is the self-signed pair it mints at /etc/pihole/tls.pem, whose only
# name is pi.hole and which no client can verify against the address it dials.
# The file is /certs/pihole.pem on both hosts, minted with
# `hack/internal-cert.sh --host pihole-rbp0.kub.local`, and the compose mounts
# ./certs read-only. hosts-pi.sh requires it, so `setup` refuses to run without
# it rather than start a panel whose certificate is the one it minted itself.
FTLCONF_webserver_tls_cert=/certs/pihole.pem
