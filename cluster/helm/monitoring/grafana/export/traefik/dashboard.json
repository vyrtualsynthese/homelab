{
  "dashboard": {
    "description": "The router in front of everything: traffic, latency, errors, the certificate store and the config reloads. Created 2026-11-21 and exported to cluster/helm/monitoring/grafana/export/traefik/.",
    "links": [
      {
        "asDropdown": false,
        "icon": "external link",
        "tags": [],
        "targetBlank": true,
        "title": "Traefik native dashboard",
        "tooltip": "basic auth + LAN only",
        "type": "link",
        "url": "https://traefik.kub.local/dashboard/"
      },
      {
        "asDropdown": false,
        "icon": "doc",
        "tags": [],
        "targetBlank": true,
        "title": "Alerts: what is monitored",
        "tooltip": "",
        "type": "link",
        "url": "https://docs.kub.local/homelab/develop/reference/alerts/"
      }
    ],
    "panels": [
      {
        "collapsed": false,
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "id": 1,
        "panels": [],
        "title": "Traffic",
        "type": "row"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "description": "The ten busiest routers. Router names carry the app, so a dropped app shows here before an alert fires.",
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 0,
              "lineWidth": 1,
              "showPoints": "never",
              "stacking": {
                "group": "A",
                "mode": "none"
              }
            },
            "unit": "reqps"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 1
        },
        "id": 2,
        "options": {
          "legend": {
            "calcs": [
              "lastNotNull",
              "max"
            ],
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "PBFA97CFB590B2093"
            },
            "expr": "topk(10, sum by (router) (rate(traefik_router_requests_total[5m])))",
            "legendFormat": "{{router}}",
            "range": true,
            "refId": "A"
          }
        ],
        "title": "Requests per second",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "description": "Requests per second by status class. 5xx is Traefik answering a broken backend or a broken route; 499 is the client leaving first.",
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 10,
              "lineWidth": 1,
              "showPoints": "never",
              "stacking": {
                "group": "A",
                "mode": "normal"
              }
            },
            "unit": "reqps"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 1
        },
        "id": 3,
        "options": {
          "legend": {
            "calcs": [],
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "PBFA97CFB590B2093"
            },
            "expr": "sum(rate(traefik_router_requests_total{code=~\"2..\"}[5m]))",
            "legendFormat": "2xx",
            "range": true,
            "refId": "A"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "PBFA97CFB590B2093"
            },
            "expr": "sum(rate(traefik_router_requests_total{code=~\"3..\"}[5m]))",
            "legendFormat": "3xx",
            "range": true,
            "refId": "B"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "PBFA97CFB590B2093"
            },
            "expr": "sum(rate(traefik_router_requests_total{code=~\"4..\"}[5m]))",
            "legendFormat": "4xx",
            "range": true,
            "refId": "C"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "PBFA97CFB590B2093"
            },
            "expr": "sum(rate(traefik_router_requests_total{code=~\"5..\"}[5m]))",
            "legendFormat": "5xx",
            "range": true,
            "refId": "D"
          }
        ],
        "title": "Response classes",
        "type": "timeseries"
      },
      {
        "collapsed": false,
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 9
        },
        "id": 4,
        "panels": [],
        "title": "Latency and errors",
        "type": "row"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "description": "Computed from the histogram buckets the release now keeps. Before 2026-11-21 Prometheus dropped them, so no percentile existed.",
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 0,
              "lineWidth": 1,
              "showPoints": "never",
              "stacking": {
                "group": "A",
                "mode": "none"
              }
            },
            "unit": "s"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 10
        },
        "id": 5,
        "options": {
          "legend": {
            "calcs": [
              "lastNotNull",
              "max"
            ],
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "PBFA97CFB590B2093"
            },
            "expr": "histogram_quantile(0.95, sum by (le, router) (rate(traefik_router_request_duration_seconds_bucket[5m])))",
            "legendFormat": "p95 {{router}}",
            "range": true,
            "refId": "A"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "PBFA97CFB590B2093"
            },
            "expr": "histogram_quantile(0.99, sum by (le, router) (rate(traefik_router_request_duration_seconds_bucket[5m])))",
            "legendFormat": "p99 {{router}}",
            "range": true,
            "refId": "B"
          }
        ],
        "title": "p95 and p99 latency by router",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "description": "Broken backend responses as a share of that router's traffic. The rule paints above 10 % for ten minutes.",
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 0,
              "lineWidth": 1,
              "showPoints": "never",
              "stacking": {
                "group": "A",
                "mode": "none"
              }
            },
            "unit": "percentunit"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 10
        },
        "id": 6,
        "options": {
          "legend": {
            "calcs": [
              "lastNotNull",
              "max"
            ],
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "PBFA97CFB590B2093"
            },
            "expr": "sum by (router) (rate(traefik_router_requests_total{code=~\"5..\"}[5m])) / clamp_min(sum by (router) (rate(traefik_router_requests_total[5m])), 0.001)",
            "legendFormat": "{{router}}",
            "range": true,
            "refId": "A"
          }
        ],
        "title": "5xx share by router",
        "type": "timeseries"
      },
      {
        "collapsed": false,
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 18
        },
        "id": 7,
        "panels": [],
        "title": "Volume",
        "type": "row"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "description": "Request bytes in and response bytes out, across every router. A public site's shape shows here during a backup upload or a video stream.",
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 0,
              "lineWidth": 1,
              "showPoints": "never",
              "stacking": {
                "group": "A",
                "mode": "none"
              }
            },
            "unit": "Bps"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 7,
          "w": 12,
          "x": 0,
          "y": 19
        },
        "id": 8,
        "options": {
          "legend": {
            "calcs": [],
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "PBFA97CFB590B2093"
            },
            "expr": "sum(rate(traefik_router_requests_bytes_total[5m]))",
            "legendFormat": "in",
            "range": true,
            "refId": "A"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "PBFA97CFB590B2093"
            },
            "expr": "sum(rate(traefik_router_responses_bytes_total[5m]))",
            "legendFormat": "out",
            "range": true,
            "refId": "B"
          }
        ],
        "title": "Bytes per second",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "description": "The same numbers the frontend keeps. A router that never comes back to zero is holding a client that will not close.",
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 0,
              "lineWidth": 1,
              "showPoints": "never",
              "stacking": {
                "group": "A",
                "mode": "none"
              }
            },
            "unit": "short"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 7,
          "w": 12,
          "x": 12,
          "y": 19
        },
        "id": 9,
        "options": {
          "legend": {
            "calcs": [
              "lastNotNull",
              "max"
            ],
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "PBFA97CFB590B2093"
            },
            "expr": "sum by (router) (traefik_router_open_connections)",
            "legendFormat": "{{router}}",
            "range": true,
            "refId": "A"
          }
        ],
        "title": "Open connections by router",
        "type": "timeseries"
      },
      {
        "collapsed": false,
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 26
        },
        "id": 10,
        "panels": [],
        "title": "Health",
        "type": "row"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "description": "Days left before each certificate expires. The store holds eighteen names no route serves any more (docs/audit/traefik-2026-11-21.md); they renew like the rest and are the cleanup on board task 409.",
        "fieldConfig": {
          "defaults": {
            "decimals": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 21
                },
                {
                  "color": "green",
                  "value": 30
                }
              ]
            },
            "unit": "short"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 27
        },
        "id": 11,
        "options": {
          "cellHeight": "sm",
          "footer": {
            "show": false
          },
          "showHeader": true
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "PBFA97CFB590B2093"
            },
            "expr": "(traefik_tls_certs_not_after - time()) / 86400",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "title": "Certificates in the store",
        "transformations": [
          {
            "id": "labelsToFields",
            "options": {
              "merge": true,
              "mode": "columns"
            }
          },
          {
            "id": "merge",
            "options": {}
          },
          {
            "id": "filterFieldsByName",
            "options": {
              "include": {
                "names": [
                  "sans",
                  "Value #A"
                ]
              }
            }
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {
                "days left": 1,
                "sans": 0
              },
              "renameByName": {
                "Value #A": "days left"
              }
            }
          },
          {
            "id": "sortBy",
            "options": {
              "disable": false,
              "sort": [
                {
                  "desc": false,
                  "field": "days left"
                }
              ]
            }
          }
        ],
        "type": "table"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "description": "Age of the newest successful configuration load. A router that stops reloading keeps serving the last good config, so this is the only early sign that a change never landed.",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 604800
                }
              ]
            },
            "unit": "s"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 12,
          "y": 27
        },
        "id": 12,
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto",
          "wideLayout": true
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "PBFA97CFB590B2093"
            },
            "expr": "time() - max(traefik_config_last_reload_success)",
            "instant": true,
            "range": false,
            "refId": "A"
          }
        ],
        "title": "Last successful config reload",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "description": "Any failure is a config Traefik read and refused. The rule fires on the first one.",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 1
                }
              ]
            },
            "unit": "short"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 16,
          "y": 27
        },
        "id": 13,
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto",
          "wideLayout": true
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "PBFA97CFB590B2093"
            },
            "expr": "sum(increase(traefik_config_reloads_failure_total[1h])) or vector(0)",
            "instant": true,
            "range": false,
            "refId": "A"
          }
        ],
        "title": "Reload failures, 1 h",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "description": "1 means Prometheus is reading the pod's 9100. 0 means every panel on this page is about to go blank, and ScrapeTargetDown says so.",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "unit": "short"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 20,
          "y": 27
        },
        "id": 14,
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto",
          "wideLayout": true
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "PBFA97CFB590B2093"
            },
            "expr": "max(up{job=\"kubernetes-pods\",pod=~\"traefik-.*\"})",
            "instant": true,
            "range": false,
            "refId": "A"
          }
        ],
        "title": "Scrape target",
        "type": "stat"
      }
    ],
    "refresh": "30s",
    "schemaVersion": 39,
    "tags": [
      "homelab",
      "traefik"
    ],
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timezone": "browser",
    "title": "Homelab \u00b7 Traefik",
    "uid": "homelab-traefik"
  },
  "folderUid": "homelab",
  "overwrite": true
}
