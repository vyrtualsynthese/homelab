    "annotations": {
      "description": "Check the app behind the router first: a 502 or 504 here is Traefik answering for a backend that is down or refusing the port. A 500 that is steady across several routers means the router itself is broken. The dashboard panel '5xx share by router' carries the same numbers. The router label is namespace/template-hash, so the name is the route's IngressRoute, not the hostname: get it with kubectl get ingressroute -A | grep <name>.",
      "summary": "Traefik router {{ $labels.router }} is failing more than 10 % of its requests"
    },
    "condition": "C",
    "data": [
      {
        "datasourceUid": "PBFA97CFB590B2093",
        "model": {
          "editorMode": "code",
          "expr": "(sum by (router) (rate(traefik_router_requests_total{code=~\"5..\"}[5m])) / clamp_min(sum by (router) (rate(traefik_router_requests_total[5m])), 0.001) > 0.10) and on(router) (sum by (router) (rate(traefik_router_requests_total[5m])) > 0.01)",
          "instant": true,
