  {
    "annotations": {
      "description": "One of two things: a config Traefik read and refused (a failure in the last 15 minutes), or no successful reload for 24 h, which means the live config and this repository have drifted apart. Read the pod log first: kubectl -n kube-system logs deploy/traefik --tail=100 names the file and the line Traefik refused. Traefik keeps serving the last good config, so a broken source file looks healthy until the next restart. Live reloads come from the IngressRoute CRDs, so a chart change that never applied shows here and nowhere else.",
      "summary": "Traefik is not reloading its configuration"
    },
    "condition": "C",
    "data": [
      {
        "datasourceUid": "PBFA97CFB590B2093",
        "model": {
          "editorMode": "code",
          "expr": "sum(increase(traefik_config_reloads_failure_total[15m])) > 0 or (time() - max(traefik_config_last_reload_success)) > 86400",
          "instant": true,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "range": false,
          "refId": "A"
        },
