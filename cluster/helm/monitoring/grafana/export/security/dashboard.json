    "panels": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "description": "2 = alerting, 1 = watch, 0 = calm. 2 when more than 20 bans landed in the last hour, when the posture counts moved, when the exporter is stale or a family it publishes is gone, or when refusals are above 85 % of all requests. 1 when any ban is active or more than 20 sign-ins failed in 15 minutes. 85 % is the top of the measured hourly band (0.33-81.13 % over 92 samples) plus a margin; the 20 % this started from sat inside the band, with 42 of 92 hours above it. Nothing here reads Prometheus's ALERTS family: Grafana evaluates every rule in this cluster, so that family is empty and a term on it would never fire.",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "decimals": 0,
            "mappings": [
              {
                "options": {
                  "0": {
                    "color": "green",
                    "index": 0,
                    "text": "Calm"
                  },
                  "1": {
                    "color": "orange",
                    "index": 1,
                    "text": "Watch"
                  },
                  "2": {
                    "color": "red",
                    "index": 2,
                    "text": "Alerting"
                  }
                },
                "type": "value"
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 1
                },
                {
                  "color": "red",
                  "value": 2
                }
              ]
            },
            "unit": "none"
          },
          "overrides": []
        },
