        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "PBFA97CFB590B2093"
            },
            "expr": "clamp_max( 2 * (delta(sum(cs_active_decisions{origin=\"crowdsec\"})[1h:1m]) > bool 20 or vector(0)) + 2 * (count(homelab_security_ungated_routes > 0)        or count(homelab_security_public_hosts != 9)        or count(homelab_security_privileged_workloads != 7) or vector(0)) + 2 * (((time() - homelab_security_exporter_last_success_timestamp_seconds > 600) or absent(homelab_security_exporter_last_success_timestamp_seconds) or absent(fw_bouncer_banned_ips) or absent(cs_active_decisions) or absent(cs_parser_hits_ok_total) or vector(0)) > bool 0) + (sum(fw_bouncer_banned_ips) > bool 0 or vector(0)) + (100 * sum(rate(traefik_router_requests_total{code=~\"4..\"}[15m])) / sum(rate(traefik_router_requests_total[15m])) > bool 85 or vector(0)) + (sum(homelab_authentik_signins_15m{outcome=\"failure\"} > bool 20) or vector(0)), 2)",
            "instant": true,
            "range": false,
            "refId": "A"
          }
        ],
        "title": "Danger state",
        "type": "stat"
      },
