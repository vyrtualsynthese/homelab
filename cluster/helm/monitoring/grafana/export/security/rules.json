    "noDataState": "OK",
    "execErrState": "OK",
    "annotations": {
      "description": "No request reached the LAPI's decision stream for ten minutes. The bouncer keeps exporting its metrics, so `SecurityStackBlind` stays green while the ban set on `streaming` is frozen. Look at the host service first (`systemctl status crowdsec-firewall-bouncer` on `streaming`, `journalctl -u crowdsec-firewall-bouncer -n 50`), then `cscli bouncers list` from the LAPI pod: a bouncer that runs but never polls has usually lost the LAPI address or been given a stale key. The metric has one series for the whole cluster, so nothing names a host. If the series is gone rather than flat, `SecurityStackBlind` reports that fault instead.",
      "summary": "The firewall bouncer has not polled the LAPI for 10 minutes"
    },
    "labels": {
      "severity": "critical"
    },
    "provenance": "api",
    "isPaused": false,
    "notification_settings": null,
