{
  "baseBranches": [
    "develop"
  ],
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "docker:enableMajor"
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pins annotated with '# renovate:' in chart values, for dependencies that are not an image block: qBittorrent's VueTorrent installer reads its release tag and Alpine base this way.",
      "fileMatch": [
        "^cluster/helm/media-stack/qbittorrent/values\\.yaml$"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*(?:version|initTag): \"?(?<currentValue>[^\"\\n]+?)\"?\\s*\\n"
      ]
    }
  ],
  "argocd": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "ignorePaths": [
    "cluster/helm/_archive/**",
    "kubectl/**",
    "ansible/**",
    "cluster/infrastructure/**"
  ],
  "packageRules": [
    {
      "matchCurrentValue": "/^(?<major>\\d+)(?:\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?)?-(?<compatibility>.+)-(?<build>\\d+)(?:-r(?<revision>\\d+))?$/",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "bitnami/**",
        "docker.io/bitnami/**",
        "gcr.io/bitnami-containers/**",
        "lscr.io/linuxserver/**"
      ],
      "versioning": "regex:^(?<major>\\d+)(?:\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?)?(:?-(?<compatibility>.+)-(?<build>\\d+)(?:-r(?<revision>\\d+))?)?$"
    },
    {
      "groupName": "authentik",
      "matchPackageNames": [
        "/authentik/"
      ]
    }
  ]
}
