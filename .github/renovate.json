{
  "baseBranchPatterns": [
    "develop"
  ],
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "docker:enableMajor"
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "argocd": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "ignorePaths": [
    "cluster/helm/_archive/**",
    "kubectl/**",
    "ansible/**",
    "cluster/infrastructure/**"
  ]
}
