<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0" xmlns:frss="https://freshrss.org/opml">
  <head><title>AshuLab FreshRSS feed set</title></head>
  <body>
    <outline text="Jeux" title="Jeux">
      <outline type="rss" text="Guild Wars 2" title="Guild Wars 2" xmlUrl="https://www.guildwars2.com/en/feed/" frss:cssFullContent="#content"/>
      <outline type="rss" text="Steam" title="Steam" xmlUrl="https://store.steampowered.com/feeds/news.xml?l=english"/>
      <outline type="rss" text="Discord blog" title="Discord blog" xmlUrl="https://discord.com/blog/rss.xml" frss:cssFullContent="article"/>
      <outline type="HTML+XPath" text="Star Citizen comm-link" title="Star Citizen comm-link"
               xmlUrl="https://robertsspaceindustries.com/comm-link" htmlUrl="https://robertsspaceindustries.com/comm-link"
               frss:xPathItem="//a[contains(@href,'/comm-link/transmission/')]"
               frss:xPathItemTitle="normalize-space(.)"
               frss:xPathItemUri="@href"/>
      <outline type="HTML+XPath" text="Final Fantasy XIV" title="Final Fantasy XIV"
               xmlUrl="https://na.finalfantasyxiv.com/lodestone/news/" htmlUrl="https://na.finalfantasyxiv.com/lodestone/news/"
               frss:xPathItem="//a[contains(@href,'/lodestone/news/detail/')]"
               frss:xPathItemTitle="normalize-space(.)"
               frss:xPathItemUri="@href"
               frss:cssFullContent="article"/>
      <outline type="HTML+XPath" text="Elite Dangerous" title="Elite Dangerous"
               xmlUrl="https://www.elitedangerous.com/news" htmlUrl="https://www.elitedangerous.com/news"
               frss:xPathItem="//*[contains(@class,'__article-info')]//a[starts-with(@href,'/news/') and not(contains(@href,'/news/updates/'))]"
               frss:xPathItemTitle="normalize-space(.)"
               frss:xPathItemUri="@href"
               frss:cssFullContent="main"/>
    </outline>
    <outline text="Dev" title="Dev">
      <outline type="rss" text="Docker blog" title="Docker blog" xmlUrl="https://www.docker.com/feed/" frss:cssFullContent=".entry-content"/>
      <outline type="rss" text="Kubernetes blog" title="Kubernetes blog" xmlUrl="https://kubernetes.io/feed.xml" frss:cssFullContent="main"/>
      <outline type="rss" text="WSL2" title="WSL2" xmlUrl="https://devblogs.microsoft.com/commandline/feed/" frss:cssFullContent=".entry-content"/>
      <outline type="rss" text="Logseq blog" title="Logseq blog" xmlUrl="https://blog.logseq.com/rss/" frss:cssFullContent="article"/>
    </outline>
    <outline text="IA" title="IA">
      <outline type="rss" text="Mistral" title="Mistral" xmlUrl="https://mistral.ai/news/rss#force_feed"/>
      <outline type="HTML+XPath" text="Anthropic / Claude" title="Anthropic / Claude"
               xmlUrl="https://www.anthropic.com/news" htmlUrl="https://www.anthropic.com/news"
               frss:xPathItem="//li[@data-listing-row]//a[contains(@class,'_title-link')]"
               frss:xPathItemTitle="normalize-space(.)"
               frss:xPathItemUri="@href"
               frss:cssFullContent="article"/>
    </outline>
    <outline text="Boutiques" title="Boutiques">
      <outline type="rss" text="Rise of Gunpla — new kits" title="Rise of Gunpla — new kits" xmlUrl="https://riseofgunpla.com/feed?post_type=product" frss:cssFullContent=".entry-content"/>
    </outline>
    <outline text="Veille" title="Veille">
      <outline type="rss" text="selfh.st" title="selfh.st" xmlUrl="https://selfh.st/rss/" frss:cssFullContent="article"/>
      <outline type="rss" text="Phoronix" title="Phoronix" xmlUrl="https://www.phoronix.com/rss.php" frss:cssFullContent="article"/>
      <outline type="rss" text="Simon Willison" title="Simon Willison" xmlUrl="https://simonwillison.net/atom/everything/"/>
      <outline type="rss" text="Hacker News front page" title="Hacker News front page" xmlUrl="https://hnrss.org/frontpage"/>
      <outline type="rss" text="Lobsters" title="Lobsters" xmlUrl="https://lobste.rs/rss"/>
    </outline>
  </body>
</opml>
